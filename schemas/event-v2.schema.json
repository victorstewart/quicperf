{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://quicperf.invalid/schemas/event-v2.schema.json",
  "title":"JournalEventV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","campaign_id","session_id","microblock_id","trial_id","attempt_id","source","event_sequence","event_type","raw_timestamp_ns","payload"],
  "properties":{
    "schema_version":{"const":"quicperf.event.v2"},
    "campaign_id":{"$ref":"#/$defs/digest"},"session_id":{"$ref":"#/$defs/digest"},"microblock_id":{"$ref":"#/$defs/digest"},"trial_id":{"$ref":"#/$defs/digest"},"attempt_id":{"$ref":"#/$defs/digest"},
    "source":{"enum":["coordinator","server","reference_client","path_controller"]},
    "event_sequence":{"type":"integer","minimum":0,"maximum":9223372036854775807},
    "event_type":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},
    "raw_timestamp_ns":{"type":"integer","minimum":0,"maximum":9223372036854775807},
    "payload":{"type":"object"}
  },
  "$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
