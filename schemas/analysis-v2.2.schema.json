{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quicperf.invalid/schemas/analysis-v2.2.schema.json",
  "title": "AnalysisV2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_kind",
    "complete",
    "diagnostic_unqualified_host",
    "publication_valid",
    "reasons",
    "runtime_efficiency",
    "watermark"
  ],
  "properties": {
    "schema_version": {"const": "quicperf.analysis.v2.2"},
    "campaign_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign_kind": {"type": "string", "minLength": 1},
    "complete": {"type": "boolean"},
    "diagnostic_unqualified_host": {"type": "boolean"},
    "publication_valid": {"type": "boolean"},
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "runtime_efficiency": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session",
          "wall_ns",
          "useful_measurement_ns",
          "useful_wall_fraction_decimal",
          "publication_qualification_gate",
          "operational_session_timeout_ns",
          "operational_timeout_exceeded"
        ],
        "properties": {
          "session": {"type": "integer", "minimum": 1, "maximum": 2},
          "wall_ns": {"type": "integer", "minimum": 0},
          "useful_measurement_ns": {"type": "integer", "minimum": 0},
          "useful_wall_fraction_decimal": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
          },
          "publication_qualification_gate": {"const": true},
          "operational_session_timeout_ns": {
            "type": "integer",
            "minimum": 1
          },
          "operational_timeout_exceeded": {"type": "boolean"}
        }
      }
    },
    "watermark": {
      "type": ["string", "null"]
    }
  }
}
