NAME lsquic
VERSION 4.7.0-quicperf5
SYSTEM_LIBS ALLOW
DEPENDS boringssl VERSION main-beddb58-pic
DEPENDS zlib VERSION 1.3.2
SOURCE GIT https://github.com/litespeedtech/lsquic.git 39718e50d60405efcb4e3bb6a8b7d9e28aee96eb
GIT_SUBMODULES RECURSIVE
BUILD_SYSTEM CMAKE
CMAKE_ARG "-DCMAKE_PREFIX_PATH=${dep:zlib}"
CMAKE_ARG "-DCMAKE_INCLUDE_PATH=${dep:zlib}/include"
CMAKE_ARG "-DCMAKE_LIBRARY_PATH=${dep:zlib}/lib"
CMAKE_DEFINE LSQUIC_BIN=OFF
CMAKE_DEFINE LSQUIC_TESTS=OFF
CMAKE_DEFINE LSQUIC_SHARED_LIB=OFF
CMAKE_DEFINE BORINGSSL_INCLUDE=${dep:boringssl}/include
CMAKE_DEFINE BORINGSSL_DIR=${dep:boringssl}
CMAKE_BUILD_SH <<'EOF'
set -eu
source_dir="$DEPO_SOURCE_DIR"
patch_file="$DEPO_BUILD_DIR/quicperf-dependency.patch"
test "$(git -C "$source_dir" rev-parse HEAD)" = "39718e50d60405efcb4e3bb6a8b7d9e28aee96eb"
test "$(git -C "$source_dir" rev-parse 'HEAD^{tree}')" = "c3d2683cd7205a33912a302731b1a2c4167298c6"
cat > "$patch_file" <<'QUICPERF_DEPENDENCY_PATCH'
diff --git a/include/lsquic.h b/include/lsquic.h
index 38a30ee230543af79ee82d5f02e2d59336c228bc..353fbd170542b94b00452df41fe014f9c01c9717 100644
--- a/include/lsquic.h
+++ b/include/lsquic.h
@@ -227,6 +227,12 @@ struct lsquic_stream_if {
      * just one direction in IETF QUIC.
      */
     void (*on_reset)    (lsquic_stream_t *s, lsquic_stream_ctx_t *h, int how);
+    /**
+     * Optional extended reset callback.  It has the same `how' semantics as
+     * on_reset and additionally reports the peer's application error code.
+     */
+    void (*on_reset_ext)(lsquic_stream_t *s, lsquic_stream_ctx_t *h, int how,
+                                                        uint64_t error_code);
     /**
      * Optional callback is called when a CONNECTION_CLOSE frame is received.
      * This allows the application to log low-level diagnostic information about
@@ -1515,6 +1521,20 @@ lsquic_engine_connect (lsquic_engine_t *, enum lsquic_version,
                        /** Resumption token: optional */
                        const unsigned char *token, size_t token_sz);
 
+/**
+ * Extended client connection constructor.  When `use_0rtt' is zero, session
+ * resumption remains enabled but TLS early data and cached transport-parameter
+ * use before handshake confirmation are disabled.
+ */
+lsquic_conn_t *
+lsquic_engine_connect_ext (lsquic_engine_t *, enum lsquic_version,
+                       const struct sockaddr *local_sa,
+                       const struct sockaddr *peer_sa,
+                       void *peer_ctx, lsquic_conn_ctx_t *conn_ctx,
+                       const char *hostname, unsigned short base_plpmtu,
+                       const unsigned char *sess_resume, size_t sess_resume_len,
+                       const unsigned char *token, size_t token_sz, int use_0rtt);
+
 /**
  * Pass incoming packet to the QUIC engine.  This function can be called
  * more than once in a row.  After you add one or more packets, call
@@ -1611,6 +1631,16 @@ lsquic_conn_going_away (lsquic_conn_t *);
 void
 lsquic_conn_close (lsquic_conn_t *);
 
+/** Send an application CONNECTION_CLOSE with the supplied code and reason. */
+int
+lsquic_conn_close_ext (lsquic_conn_t *, uint64_t error_code,
+                                            const char *reason, size_t reason_len);
+
+/** Return retained client-side 0-RTT state. */
+int
+lsquic_conn_get_early_data_status (const lsquic_conn_t *, int *attempted,
+                                                    int *accepted, int *rejected);
+
 /**
  * Set whether you want to read from stream.  If @param is_want is true,
  * @ref on_read() will be called when there is readable data in the
@@ -1795,6 +1825,12 @@ lsquic_conn_is_push_enabled (lsquic_conn_t *);
 /** Possible values for how are 0, 1, and 2.  See shutdown(2). */
 int lsquic_stream_shutdown(lsquic_stream_t *s, int how);
 
+/** Send RESET_STREAM with the supplied application error code. */
+int lsquic_stream_reset_ext(lsquic_stream_t *s, uint64_t error_code);
+
+/** Send STOP_SENDING with the supplied application error code. */
+int lsquic_stream_stop_sending_ext(lsquic_stream_t *s, uint64_t error_code);
+
 int lsquic_stream_close(lsquic_stream_t *s);
 
 /**
diff --git a/src/liblsquic/lsquic_eng_hist.h b/src/liblsquic/lsquic_eng_hist.h
index 0e554df4a8d331f2d33f5522626a5181307f163f..071be63930e34aa0c81da85e8c94c484e6d430d0 100644
--- a/src/liblsquic/lsquic_eng_hist.h
+++ b/src/liblsquic/lsquic_eng_hist.h
@@ -10,7 +10,7 @@
 
 #include "lsquic_int_types.h"
 
-#define ENG_HIST_ENABLED 1
+#define ENG_HIST_ENABLED 0
 
