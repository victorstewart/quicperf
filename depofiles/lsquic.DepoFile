+int
+lsquic_stream_reset_ext (lsquic_stream_t *stream, uint64_t error_code)
+{
+    if (!(stream->sm_bflags & SMBF_IETF))
+    {
+        errno = ENOTSUP;
+        return -1;
+    }
+    if ((stream->stream_flags &
+                (STREAM_RST_SENT|STREAM_FIN_SENT|STREAM_U_WRITE_DONE))
+                                    || (stream->sm_qflags & SMQF_SEND_RST))
+    {
+        errno = EALREADY;
+        return -1;
+    }
+    stream_reset(stream, error_code, 0);
+    maybe_conn_to_tickable_if_writeable(stream, 1);
+    return 0;
+}
+
+
+int
+lsquic_stream_stop_sending_ext (lsquic_stream_t *stream, uint64_t error_code)
+{
+    if (!(stream->sm_bflags & SMBF_IETF))
+    {
+        errno = ENOTSUP;
+        return -1;
+    }
+    if (stream->stream_flags & STREAM_U_READ_DONE)
+    {
+        errno = EALREADY;
+        return -1;
+    }
+    stream->stop_sending_error_code = error_code;
+    return lsquic_stream_shutdown(stream, 0);
+}
+
+
 void
 lsquic_stream_shutdown_internal (lsquic_stream_t *stream)
 {
