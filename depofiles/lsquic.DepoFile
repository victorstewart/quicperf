diff --git a/src/liblsquic/lsquic_conn.c b/src/liblsquic/lsquic_conn.c
index d3d723ee73b8bb281f95462ceb78caa7e5caaf39..413acf8cb315d4c3eb3d31c3b5664b239200fd1c 100644
--- a/src/liblsquic/lsquic_conn.c
+++ b/src/liblsquic/lsquic_conn.c
@@ -1,6 +1,8 @@
 /* Copyright (c) 2017 - 2026 LiteSpeed Technologies Inc.  See LICENSE. */
 #include <assert.h>
+#include <errno.h>
 #include <inttypes.h>
+#include <limits.h>
 #include <string.h>
 #include <sys/queue.h>
 
@@ -180,6 +182,43 @@ lsquic_conn_close (struct lsquic_conn *lconn)
 }
 
 
+int
+lsquic_conn_close_ext (struct lsquic_conn *lconn, uint64_t error_code,
+                                            const char *reason, size_t reason_len)
+{
+    if (!(lconn->cn_flags & LSCONN_IETF))
+    {
+        errno = ENOTSUP;
+        return -1;
+    }
+    if (error_code > UINT_MAX || reason_len >= 0x100 || reason_len > INT_MAX
+            || (reason_len && (!reason || memchr(reason, '\0', reason_len))))
+    {
+        errno = EINVAL;
+        return -1;
+    }
+    lconn->cn_if->ci_abort_error(lconn, 1, (unsigned) error_code, "%.*s",
+                        (int) reason_len, reason ? reason : "");
+    return 0;
+}
+
+
+int
+lsquic_conn_get_early_data_status (const struct lsquic_conn *lconn,
+                                    int *attempted, int *accepted, int *rejected)
+{
+    if (!attempted || !accepted || !rejected)
+    {
+        errno = EINVAL;
+        return -1;
+    }
+    *attempted = !!(lconn->cn_flags & LSCONN_0RTT_ATTEMPTED);
+    *accepted = !!(lconn->cn_flags & LSCONN_0RTT_ACCEPTED);
+    *rejected = !!(lconn->cn_flags & LSCONN_0RTT_REJECTED);
+    return 0;
+}
+
+
 int
 lsquic_conn_is_push_enabled (lsquic_conn_t *lconn)
 {
@@ -369,4 +408,3 @@ lsquic_conn_get_param (lsquic_conn_t *lconn, enum lsquic_conn_param param,
         return lconn->cn_if->ci_get_param(lconn, param, value, value_len);
     return -1;
 }
