+    .esfi_get_negotiated_tls
+                         = iquic_esfi_get_negotiated_tls,
     .esfi_get_peer_transport_params
                          = iquic_esfi_get_peer_transport_params,
     .esfi_reset_dcid     = iquic_esfi_reset_dcid,
@@ -2908,6 +2967,8 @@ cache_info (struct enc_sess_iquic *enc_sess)
