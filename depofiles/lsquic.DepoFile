+int
+lsquic_conn_get_negotiated (const lsquic_conn_t *lconn,
+                            struct lsquic_conn_negotiated *negotiated)
+{
+    const struct transport_params *params;
+    const lsquic_cid_t *cid;
+
+    if (!negotiated || !(lconn->cn_flags & LSCONN_IETF)
+            || !(lconn->cn_flags & LSCONN_HANDSHAKE_DONE)
+            || !lconn->cn_enc_session
+            || lconn->cn_esf.i->esfi_get_negotiated_tls(
+                                    lconn->cn_enc_session, negotiated) != 0)
+        return -1;
+    params = lconn->cn_esf.i->esfi_get_peer_transport_params(
+                                                    lconn->cn_enc_session);
+    if (!params)
+        return -1;
+    negotiated->quic_version = lconn->cn_version == LSQVER_I001 ? 1 : 0;
+    negotiated->max_idle_timeout = params->tp_max_idle_timeout;
+    negotiated->max_udp_payload_size = params->tp_max_udp_payload_size;
+    negotiated->initial_max_data = params->tp_init_max_data;
+    negotiated->initial_max_stream_data_bidi_local
+                                = params->tp_init_max_stream_data_bidi_local;
+    negotiated->initial_max_stream_data_bidi_remote
+                                = params->tp_init_max_stream_data_bidi_remote;
+    negotiated->initial_max_stream_data_uni
+                                = params->tp_init_max_stream_data_uni;
+    negotiated->initial_max_streams_bidi = params->tp_init_max_streams_bidi;
+    negotiated->initial_max_streams_uni = params->tp_init_max_streams_uni;
+    negotiated->ack_delay_exponent = params->tp_ack_delay_exponent;
+    negotiated->max_ack_delay = params->tp_max_ack_delay;
+    negotiated->active_connection_id_limit
+                                = params->tp_active_connection_id_limit;
+    negotiated->max_datagram_frame_size
+                        = params->tp_numerics[TPI_MAX_DATAGRAM_FRAME_SIZE];
+    negotiated->disable_active_migration
+                        = !!(params->tp_set & (1 << TPI_DISABLE_ACTIVE_MIGRATION));
+    cid = lsquic_conn_id(lconn);
+    negotiated->connection_id_len = cid ? cid->len : 0;
+    return 0;
+}
+
+
 enum lsquic_crypto_ver
