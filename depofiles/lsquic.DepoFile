+static int
+read_negotiated_tls (SSL *ssl, struct lsquic_conn_negotiated *negotiated)
+{
+    const SSL_CIPHER *cipher;
+    const unsigned char *alpn;
+    unsigned alpn_len;
+    X509 *peer;
+
+    memset(negotiated, 0, sizeof(*negotiated));
+    cipher = SSL_get_current_cipher(ssl);
+    if (!cipher)
+        return -1;
+    negotiated->tls_version = SSL_version(ssl);
+    negotiated->tls_cipher_suite = SSL_CIPHER_get_id(cipher) & 0xFFFF;
+    negotiated->tls_key_exchange_group = SSL_get_curve_id(ssl);
+    negotiated->tls_peer_signature_algorithm
+                                    = SSL_get_peer_signature_algorithm(ssl);
+    peer = SSL_get_peer_certificate(ssl);
+    negotiated->tls_peer_certificate_present = peer != NULL;
+    negotiated->tls_peer_certificate_verified = peer != NULL
+                                      && SSL_get_verify_result(ssl) == X509_V_OK;
+    if (peer)
+        X509_free(peer);
+    SSL_get0_alpn_selected(ssl, &alpn, &alpn_len);
+    if (alpn_len > sizeof(negotiated->alpn))
+        return -1;
+    negotiated->alpn_len = alpn_len;
+    if (alpn_len)
+        memcpy(negotiated->alpn, alpn, alpn_len);
+    return 0;
+}
+
+
+static int
+iquic_esfi_get_negotiated_tls (enc_session_t *enc_session_p,
+                                struct lsquic_conn_negotiated *negotiated)
+{
+    struct enc_sess_iquic *const enc_sess = enc_session_p;
+
+    if (enc_sess->esi_ssl)
+        return read_negotiated_tls(enc_sess->esi_ssl, negotiated);
+    if (enc_sess->esi_flags & ESI_CACHED_INFO)
+    {
+        *negotiated = enc_sess->esi_cached_info.negotiated;
+        return 0;
+    }
+    return -1;
+}
+
+
