diff --git a/src/quicperf_clock.rs b/src/quicperf_clock.rs
new file mode 100644
index 0000000..3e38b9d
--- /dev/null
+++ b/src/quicperf_clock.rs
@@ -0,0 +1,90 @@
+// Copyright (c) 2023 The TQUIC Authors.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+//! Quicperf caller-controlled monotonic clock.
+
+use std::cell::RefCell;
+use std::sync::OnceLock;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+const SYNTHETIC_UNIX_EPOCH_SECONDS: u64 = 1_700_000_000;
+static OPAQUE_EPOCH: OnceLock<Instant> = OnceLock::new();
+static RAW_EPOCH_NS: OnceLock<u64> = OnceLock::new();
+
+struct Clock {
+    opaque_epoch: Instant,
+    last_raw_ns: Option<u64>,
+    current: Instant,
+}
+
+impl Clock {
+    fn new() -> Self {
+        // This opaque epoch is created before the worker enters READY. All
+        // subsequent transport time is derived from caller-supplied raw time.
+        let opaque_epoch = *OPAQUE_EPOCH.get_or_init(Instant::now);
+        Self {
+            opaque_epoch,
+            last_raw_ns: None,
+            current: opaque_epoch,
+        }
+    }
+
+    fn set_raw_ns(&mut self, raw_ns: u64) -> bool {
+        if raw_ns == 0 || self.last_raw_ns.is_some_and(|last| raw_ns < last) {
+            return false;
+        }
+
+        // Every endpoint shard must map raw time to the same opaque Instant
+        // even when its caller-owned event loop moves between worker threads.
+        let raw_epoch_ns = *RAW_EPOCH_NS.get_or_init(|| raw_ns);
+        if raw_ns < raw_epoch_ns {
+            return false;
+        }
+        let Some(current) = self
+            .opaque_epoch
+            .checked_add(Duration::from_nanos(raw_ns - raw_epoch_ns))
+        else {
+            return false;
+        };
+        self.current = current;
+        self.last_raw_ns = Some(raw_ns);
+        true
+    }
+}
+
+thread_local! {
+    static CLOCK: RefCell<Clock> = RefCell::new(Clock::new());
+}
+
+pub(crate) fn set_raw_ns(raw_ns: u64) -> bool {
+    CLOCK.with(|clock| clock.borrow_mut().set_raw_ns(raw_ns))
+}
+
+pub(crate) fn now() -> Instant {
+    CLOCK.with(|clock| clock.borrow().current)
+}
+
+pub(crate) fn system_time() -> SystemTime {
+    CLOCK.with(|clock| {
+        let clock = clock.borrow();
+        let elapsed_ns = clock
+            .last_raw_ns
+            .zip(RAW_EPOCH_NS.get().copied())
+            .map_or(0, |(now, epoch)| now - epoch);
+        UNIX_EPOCH
+            .checked_add(Duration::from_secs(SYNTHETIC_UNIX_EPOCH_SECONDS))
+            .and_then(|epoch| epoch.checked_add(Duration::from_nanos(elapsed_ns)))
+            .expect("caller time already passed the stricter Instant bound")
+    })
+}
