NAME tquic
VERSION datagram-t2-50f5a55-quicperf8
SYSTEM_LIBS ALLOW
DEPENDS boringssl VERSION main-beddb58-pic
SOURCE GIT https://github.com/Tencent/tquic.git 50f5a55975fe5b64cce708bbf227dd0f29b59ee5
GIT_SUBMODULES RECURSIVE
BUILD_SYSTEM CARGO
CARGO_BUILD_SH <<'EOF'
set -eu
source_dir="$DEPO_SOURCE_DIR"
patch_file="$DEPO_BUILD_DIR/quicperf-dependency.patch"
settings_patch_file="$DEPO_BUILD_DIR/quicperf-negotiated-settings.patch"
lifecycle_patch_file="$DEPO_BUILD_DIR/quicperf-lifecycle-capacity.patch"
buffer_patch_file="$DEPO_BUILD_DIR/quicperf-stream-buffer-accounting.patch"
test "$(git -C "$source_dir" rev-parse HEAD)" = "50f5a55975fe5b64cce708bbf227dd0f29b59ee5"
test "$(git -C "$source_dir" rev-parse 'HEAD^{tree}')" = "5cf020fd0a3e71fbb26f892da3f1a2b1cea9f6dd"
cat > "$patch_file" <<'QUICPERF_DEPENDENCY_PATCH'
diff --git a/include/tquic.h b/include/tquic.h
index f0994b9..4b3d6a9 100644
--- a/include/tquic.h
+++ b/include/tquic.h
@@ -433,6 +433,12 @@ typedef struct quic_conn_stats_t {
    * Total number of bytes lost on the connection.
    */
   uint64_t lost_bytes;
+  /** Number of DATA_BLOCKED frames serialized. */
+  uint64_t data_blocked_sent;
+  /** Number of STREAM_DATA_BLOCKED frames serialized. */
+  uint64_t stream_data_blocked_sent;
+  /** Number of loss-detection wakeups that selected retransmittable data. */
+  uint64_t recovery_wakeups;
 } quic_conn_stats_t;
 
 typedef struct http3_methods_t {
@@ -927,6 +933,12 @@ struct quic_endpoint_t *quic_endpoint_new(struct quic_config_t *config,
                                           const struct quic_packet_send_methods_t *sender_methods,
                                           quic_packet_send_context_t sender_ctx);
 
+/**
+ * Set caller-owned raw monotonic time for all tquic work on this thread.
+ * The value must be nonzero and monotonic.
+ */
+bool quic_set_now_raw_ns(uint64_t now_raw_ns);
+
 /**
  * Destroy a QUIC endpoint.
  */
@@ -1137,6 +1149,17 @@ const struct quic_path_stats_t *quic_conn_path_stats(struct quic_conn_t *conn,
  */
 const struct quic_conn_stats_t *quic_conn_stats(struct quic_conn_t *conn);
 
+/**
+ * Return exact terminal facts learned from peer-originated stream frames.
+ */
+void quic_stream_peer_terminal(const struct quic_conn_t *conn,
+                               uint64_t stream_id,
+                               bool *fin,
+                               bool *reset_stream,
+                               uint64_t *reset_stream_error,
+                               bool *stop_sending,
+                               uint64_t *stop_sending_error);
+
 /**
  * Return the trace id of the connection
  */
