 uint32_t xqc_conn_get_quic_version(xqc_connection_t *conn);
 
+/** Return retained and not-yet-handed-off send-queue packet counts. */
+XQC_EXPORT_PUBLIC_API
+xqc_int_t xqc_conn_get_send_queue_state(xqc_connection_t *conn,
+    uint64_t *packets_used, uint64_t *packets_max, uint64_t *unsent_packets);
