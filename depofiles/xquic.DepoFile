diff --git a/src/transport/xqc_conn.c b/src/transport/xqc_conn.c
index 91442d3..54b162c 100644
--- a/src/transport/xqc_conn.c
+++ b/src/transport/xqc_conn.c
@@ -3198,6 +3198,36 @@ xqc_conn_get_errno(xqc_connection_t *conn)
     return conn->conn_err;
 }
 
+xqc_int_t
+xqc_conn_close_application(xqc_connection_t *conn, uint64_t err_code)
+{
+    if (conn == NULL) {
+        return -XQC_EPARAM;
+    }
+    if (conn->conn_state >= XQC_CONN_STATE_DRAINING) {
+        return XQC_OK;
+    }
+    conn->conn_err = err_code;
+    conn->local_application_close = XQC_TRUE;
+    XQC_CONN_CLOSE_MSG(conn, "local application close");
+    xqc_conn_closing(conn);
+    return xqc_conn_close(conn->engine, &conn->scid_set.user_scid);
+}
+
+xqc_bool_t
+xqc_conn_peer_close_error(xqc_connection_t *conn, uint64_t *err_code,
+    uint64_t *reason_length)
+{
+    if (conn == NULL || err_code == NULL || reason_length == NULL
+        || conn->peer_application_close_received == XQC_FALSE)
+    {
+        return XQC_FALSE;
+    }
+    *err_code = conn->peer_application_close_error;
+    *reason_length = conn->peer_application_close_reason_length;
+    return XQC_TRUE;
+}
+
