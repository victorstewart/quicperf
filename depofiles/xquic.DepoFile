 void
 xqc_stream_set_user_data(xqc_stream_t *stream, void *user_data)
 {
QUICPERF_BUFFER_PATCH
if git -C "$source_dir" apply --check "$patch_file_2"; then
  git -C "$source_dir" apply "$patch_file_2"
elif git -C "$source_dir" apply --reverse --check "$patch_file_2"; then
  :
else
  echo "quicperf treatment patch does not match pinned source" >&2
  exit 1
fi
if git -C "$source_dir" apply --check "$patch_file_3"; then
  git -C "$source_dir" apply "$patch_file_3"
elif git -C "$source_dir" apply --reverse --check "$patch_file_3"; then
  :
else
  echo "quicperf buffer patch does not match pinned source" >&2
  exit 1
fi
source_index="$DEPO_BUILD_DIR/quicperf-source.index"
rm -f "$source_index"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" read-tree HEAD
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$patch_file"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$patch_file_2"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$patch_file_3"
test "$(GIT_INDEX_FILE="$source_index" git -C "$source_dir" write-tree)" = "d35bb5a75cf16523eae5bb584fe7f9ec9f5d7b6a"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" diff --quiet --no-ext-diff -- .
cmake -S "$source_dir" -B "$DEPO_BUILD_DIR" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$DEPO_PREFIX" \
  -DCMAKE_INSTALL_LIBDIR=lib \
  -DSSL_TYPE=boringssl \
  "-DSSL_INC_PATH=${dep:boringssl}/include" \
  "-DSSL_LIB_PATH=${dep:boringssl}/lib/libssl.a;${dep:boringssl}/lib/libcrypto.a" \
  -DXQC_ENABLE_TESTING=OFF \
  -DXQC_SUPPORT_SENDMMSG_BUILD=ON \
  -DXQC_ENABLE_BBR2=ON
EOF
CMAKE_BUILD_SH <<'EOF'
cmake --build "$DEPO_BUILD_DIR" --parallel "$(nproc)"
EOF
STAGE_FILE BUILD libxquic-static.a lib/libxquic.a
STAGE_TREE SOURCE include include
TARGET xquic::xquic STATIC lib/libxquic.a INTERFACE include
LINK xquic::xquic boringssl dl pthread m
