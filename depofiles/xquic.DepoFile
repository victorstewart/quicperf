+/** Select the transport's high-priority packet queue for this stream. */
+XQC_EXPORT_PUBLIC_API
+void xqc_stream_set_high_priority(xqc_stream_t *stream, xqc_bool_t high_priority);
+
 
 XQC_EXPORT_PUBLIC_API
 xqc_int_t xqc_stream_update_settings(xqc_stream_t *stream, 
diff --git a/src/transport/xqc_conn.c b/src/transport/xqc_conn.c
index 74e1208..5954c67 100644
--- a/src/transport/xqc_conn.c
+++ b/src/transport/xqc_conn.c
@@ -7056,6 +7056,22 @@ xqc_conn_get_quic_version(xqc_connection_t *conn)
     return conn == NULL ? 0 : xqc_proto_version_value[conn->version];
 }
 
+xqc_int_t
+xqc_conn_get_send_queue_state(xqc_connection_t *conn, uint64_t *packets_used,
+    uint64_t *packets_max, uint64_t *unsent_packets)
+{
+    if (conn == NULL || conn->conn_send_queue == NULL || packets_used == NULL
+        || packets_max == NULL || unsent_packets == NULL)
+    {
+        return -XQC_EPARAM;
+    }
+
+    *packets_used = conn->conn_send_queue->sndq_packets_used;
+    *packets_max = conn->conn_send_queue->sndq_packets_used_max;
+    *unsent_packets = xqc_send_queue_get_unsent_packets_num(conn->conn_send_queue);
+    return XQC_OK;
+}
+
 /**
  * @brief set public remote transport settings
  */
diff --git a/src/transport/xqc_stream.c b/src/transport/xqc_stream.c
index 21132c0..e9e9332 100644
--- a/src/transport/xqc_stream.c
+++ b/src/transport/xqc_stream.c
@@ -688,6 +688,12 @@ xqc_stream_set_priority(xqc_stream_t *stream, xqc_stream_priority_t priority)
     stream->stream_priority = priority;
 }
 
+void
+xqc_stream_set_high_priority(xqc_stream_t *stream, xqc_bool_t high_priority)
+{
+    stream->stream_priority = high_priority ? XQC_STREAM_PRI_HIGH : XQC_STREAM_PRI_NORMAL;
+}
