diff --git a/src/transport/xqc_stream.c b/src/transport/xqc_stream.c
index 6d73dbd..65af90e 100644
--- a/src/transport/xqc_stream.c
+++ b/src/transport/xqc_stream.c
@@ -962,6 +962,70 @@ xqc_stream_close(xqc_stream_t *stream)
     return XQC_OK;
 }
 
+xqc_int_t
+xqc_stream_reset(xqc_stream_t *stream, uint64_t err_code)
+{
+    if (stream == NULL) {
+        return -XQC_EPARAM;
+    }
+    xqc_connection_t *conn = stream->stream_conn;
+    if (stream->stream_state_send >= XQC_SEND_STREAM_ST_RESET_SENT
+        || conn->conn_state >= XQC_CONN_STATE_CLOSING)
+    {
+        return XQC_OK;
+    }
+    xqc_send_queue_drop_stream_frame_packets(conn, stream->stream_id);
+    xqc_int_t ret = xqc_write_reset_stream_to_packet(
+        conn, stream, err_code, stream->stream_send_offset);
+    if (ret < 0) {
+        return ret;
+    }
+    XQC_STREAM_CLOSE_MSG(stream, "local reset");
+    xqc_stream_shutdown_write(stream);
+    xqc_engine_remove_wakeup_queue(conn->engine, conn);
+    xqc_engine_add_active_queue(conn->engine, conn);
+    xqc_engine_conn_logic(conn->engine, conn);
+    return XQC_OK;
+}
+
+xqc_int_t
+xqc_stream_stop_sending(xqc_stream_t *stream, uint64_t err_code)
+{
+    if (stream == NULL) {
+        return -XQC_EPARAM;
+    }
+    xqc_connection_t *conn = stream->stream_conn;
+    if (conn->conn_state >= XQC_CONN_STATE_CLOSING) {
+        return XQC_OK;
+    }
+    xqc_int_t ret = xqc_write_stop_sending_to_packet(conn, stream, err_code);
+    if (ret < 0) {
+        return ret;
+    }
+    xqc_engine_remove_wakeup_queue(conn->engine, conn);
+    xqc_engine_add_active_queue(conn->engine, conn);
+    xqc_engine_conn_logic(conn->engine, conn);
+    return XQC_OK;
+}
+
+xqc_int_t
+xqc_stream_peer_terminal(xqc_stream_t *stream, xqc_bool_t *fin,
+    xqc_bool_t *reset_stream, uint64_t *reset_error,
+    xqc_bool_t *stop_sending, uint64_t *stop_error)
+{
+    if (stream == NULL || fin == NULL || reset_stream == NULL || reset_error == NULL
+        || stop_sending == NULL || stop_error == NULL)
+    {
+        return -XQC_EPARAM;
+    }
+    *fin = stream->stream_stats.peer_fin_rcv_time != 0;
+    *reset_stream = stream->peer_reset_received;
+    *reset_error = stream->peer_reset_error;
+    *stop_sending = stream->peer_stop_sending_received;
+    *stop_error = stream->peer_stop_sending_error;
+    return XQC_OK;
+}
+
 xqc_int_t
 xqc_insert_passive_stream_hash(xqc_connection_t *conn, int64_t cur_max_sid, xqc_stream_id_t stream_id)
 {
