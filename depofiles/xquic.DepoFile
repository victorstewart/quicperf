+    xqc_bool_t              peer_stop_sending_received;
+    uint64_t                peer_stop_sending_error;
     const char             *stream_close_msg;
 
     struct {
@@ -299,4 +303,3 @@ xqc_bool_t xqc_is_stream_finished(xqc_stream_t *stream);
 
 void xqc_record_stream_state(xqc_stream_t *stream);
 #endif /* _XQC_STREAM_H_INCLUDED_ */
