NAME quiche
VERSION 0.29.0-quicperf5
SYSTEM_LIBS ALLOW
SOURCE GIT https://github.com/cloudflare/quiche.git e85fc8e8082e5ab57b8c0c4a5785f1b84b39901c
GIT_SUBMODULES RECURSIVE
BUILD_SYSTEM CARGO
CARGO_BUILD_SH <<'EOF'
set -eu
source_dir="$DEPO_SOURCE_DIR"
patch_file="$DEPO_BUILD_DIR/quicperf-dependency.patch"
test "$(git -C "$source_dir" rev-parse HEAD)" = "e85fc8e8082e5ab57b8c0c4a5785f1b84b39901c"
test "$(git -C "$source_dir" rev-parse 'HEAD^{tree}')" = "ff8346acfe2b0cc9240d0ce9161c5346364d084d"
cat > "$patch_file" <<'QUICPERF_DEPENDENCY_PATCH'
diff --git a/quiche/src/ffi.rs b/quiche/src/ffi.rs
index 28324ad8..d439492c 100644
--- a/quiche/src/ffi.rs
+++ b/quiche/src/ffi.rs
@@ -1154,13 +1154,14 @@ pub extern "C" fn quiche_connection_id_iter_next(
     iter: &mut ConnectionIdIter, out: &mut *const u8, out_len: &mut size_t,
 ) -> bool {
-    if let Some(conn_id) = iter.next() {
-        let id = conn_id.as_ref();
-        *out = id.as_ptr();
-        *out_len = id.len();
-        return true;
-    }
+    let Some(conn_id) = iter.cids.get(iter.index) else {
+        return false;
+    };
+    iter.index += 1;
 
-    false
+    let id = conn_id.as_ref();
+    *out = id.as_ptr();
+    *out_len = id.len();
+    true
 }
 
 #[no_mangle]
@@ -1361,6 +1362,7 @@ pub struct Stats {
     tx_buffered_inconsistent: bool,
 }
 
+#[repr(C)]
 pub struct TransportParams {
     max_idle_timeout: u64,
     max_udp_payload_size: u64,
diff --git a/quiche/include/quiche.h b/quiche/include/quiche.h
index c1f0dd8d..9205ce7b 100644
--- a/quiche/include/quiche.h
+++ b/quiche/include/quiche.h
@@ -264,6 +264,9 @@ void quiche_config_set_max_pacing_rate(quiche_config *config, uint64_t v);
 void quiche_config_enable_dgram(quiche_config *config, bool enabled,
                                 size_t recv_queue_len,
                                 size_t send_queue_len);
+// Sets the max_datagram_frame_size transport parameter.
+void quiche_config_set_max_datagram_frame_size(quiche_config *config,
+                                               uint64_t v);
 
 // Sets the maximum connection window.
 void quiche_config_set_max_connection_window(quiche_config *config, uint64_t v);
diff --git a/quiche/src/ffi.rs b/quiche/src/ffi.rs
index d439492c..0c720c25 100644
--- a/quiche/src/ffi.rs
+++ b/quiche/src/ffi.rs
@@ -391,6 +391,11 @@ pub extern "C" fn quiche_config_enable_dgram(
     config.enable_dgram(enabled, recv_queue_len, send_queue_len);
 }
 
+#[no_mangle]
+pub extern "C" fn quiche_config_set_max_datagram_frame_size(config: &mut Config, v: u64) {
+    config.set_max_datagram_frame_size(v);
+}
+
 #[no_mangle]
 pub extern "C" fn quiche_config_set_max_send_udp_payload_size(
     config: &mut Config, v: size_t,
diff --git a/quiche/src/lib.rs b/quiche/src/lib.rs
index d30a75bf..18506efa 100644
--- a/quiche/src/lib.rs
+++ b/quiche/src/lib.rs
@@ -1197,6 +1197,11 @@ impl Config {
         self.dgram_send_max_queue_len = send_queue_len;
     }
 
+    /// Sets the max_datagram_frame_size transport parameter.
+    pub fn set_max_datagram_frame_size(&mut self, v: u64) {
+        self.local_transport_params.max_datagram_frame_size = Some(v);
+    }
+
     /// Configures the max number of queued received PATH_CHALLENGE frames.
     ///
     /// When an endpoint receives a PATH_CHALLENGE frame and the queue is full,
QUICPERF_DEPENDENCY_PATCH
if git -C "$source_dir" apply --check "$patch_file"; then
  git -C "$source_dir" apply "$patch_file"
elif git -C "$source_dir" apply --reverse --check "$patch_file"; then
  :
else
  echo "quicperf dependency patch does not match pinned source" >&2
  exit 1
fi
source_index="$DEPO_BUILD_DIR/quicperf-source.index"
rm -f "$source_index"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" read-tree HEAD
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$patch_file"
test "$(GIT_INDEX_FILE="$source_index" git -C "$source_dir" write-tree)" = "910cf83e1ecf23f4224b370b5e3acd8149d9cbfd"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" diff --quiet --no-ext-diff -- .
env CARGO_PROFILE_RELEASE_LTO=fat CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 RUSTFLAGS="-C target-cpu=native -C opt-level=3" cargo build --release --features ffi --target-dir "${DEPO_BUILD_DIR}/cargo-target" -p quiche
boringssl_include="$(find "${DEPO_BUILD_DIR}/cargo-target/release/build" -path '*/out/boringssl/src/include' -type d -print -quit)"
if [[ -z "$boringssl_include" ]]; then
  cargo_home="$CARGO_HOME"
  if [[ -z "$cargo_home" ]]; then
    cargo_home="$DEPO_BUILD_DIR/cargo-home"
  fi
  boringssl_include="$(find "$cargo_home/registry/src" -path '*/boring-sys-*/deps/boringssl/src/include' -type d -print -quit)"
fi
test -n "$boringssl_include"
mkdir -p "${DEPO_BUILD_DIR}/boringssl-include"
cp -R "$boringssl_include/." "${DEPO_BUILD_DIR}/boringssl-include/"
EOF
STAGE_FILE BUILD cargo-target/release/libquiche.a lib/libquiche.a
STAGE_TREE SOURCE quiche/include include
STAGE_TREE BUILD boringssl-include boringssl/include
TARGET quiche::quiche STATIC lib/libquiche.a INTERFACE include boringssl/include
LINK quiche::quiche dl pthread m
