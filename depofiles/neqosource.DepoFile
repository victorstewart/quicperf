NAME neqosource
VERSION quicperf-c-abi-f21a27d-quicperf11
SYSTEM_LIBS ALLOW
SOURCE GIT https://github.com/victorstewart/neqo.git f21a27d5a0aef1be7516dcf2ddd7d966406a8091
BUILD_SYSTEM MANUAL
MANUAL_BUILD_SH <<'EOF'
set -eu
source_dir="$DEPO_SOURCE_DIR"
patch_file="$DEPO_BUILD_DIR/quicperf-dependency.patch"
test "$(git -C "$source_dir" rev-parse HEAD)" = "f21a27d5a0aef1be7516dcf2ddd7d966406a8091"
test "$(git -C "$source_dir" rev-parse 'HEAD^{tree}')" = "8edc217e16ed52813e86cfeae230e5effcf7b94e"
cat > "$patch_file" <<'QUICPERF_DEPENDENCY_PATCH'
diff --git a/neqo-common/src/hrtime.rs b/neqo-common/src/hrtime.rs
index 74881e51..967af11c 100644
--- a/neqo-common/src/hrtime.rs
+++ b/neqo-common/src/hrtime.rs
@@ -235,6 +235,9 @@ impl Handle {
     /// calling `HrTime::get` again with the new period, except that this applies
     /// a little hysteresis that smoothes out fluctuations.
     pub fn update(&mut self, period: Duration) {
+        if cfg!(not(any(target_os = "macos", target_os = "windows"))) {
+            return;
+        }
         self.hysteresis[self.hysteresis_index] = Period::from(period);
         self.hysteresis_index += 1;
         self.hysteresis_index %= self.hysteresis.len();
@@ -262,6 +265,7 @@ impl Handle {
 
 impl Drop for Handle {
     fn drop(&mut self) {
+        #[cfg(any(target_os = "macos", target_os = "windows"))]
         self.hrt.borrow_mut().remove(self.active);
     }
 }
@@ -340,6 +344,7 @@ impl Time {
         self.update();
     }
 
+    #[cfg(any(target_os = "macos", target_os = "windows"))]
     fn remove(&mut self, p: Period) {
         self.periods.remove(p);
         self.update();
