+    #[must_use]
+    pub fn quicperf_negotiated_transport(&self) -> Option<QuicperfNegotiatedTransport> {
+        let tps = self.tps.borrow();
+        let remote = tps.remote_handshake()?;
+        Some(QuicperfNegotiatedTransport {
+            quic_version: self.version.wire_version(),
+            initial_congestion_window_bytes: self
+                .conn_params
+                .get_initial_congestion_window()
+                .and_then(|bytes| u64::try_from(bytes).ok())
+                .unwrap_or(0),
+            max_udp_payload_size: remote.get_integer(MaxUdpPayloadSize),
+            max_ack_delay_ms: remote.get_integer(MaxAckDelay),
+            ack_delay_exponent: remote.get_integer(AckDelayExponent),
+            ack_frequency: remote.has_value(MinAckDelay),
+            active_migration: !remote.get_empty(DisableMigration),
+            active_connection_id_limit: remote.get_integer(ActiveConnectionIdLimit),
+            connection_id_bytes: self
+                .remote_initial_source_cid
+                .as_ref()
+                .map_or(0, |cid| cid.as_ref().len()),
+            max_idle_timeout_ms: remote.get_integer(TransportParameterId::IdleTimeout),
