+
+    #[test]
+    fn exact_transport_parameters() {
+        let params = ConnectionParameters::default()
+            .max_udp_payload_size(1350)
+            .max_ack_delay(Duration::from_millis(25))
+            .ack_delay_exponent(3)
+            .ack_frequency(false)
+            .active_connection_id_limit(2);
+        let mut cid_manager = ConnectionIdManager::new(
+            std::rc::Rc::new(std::cell::RefCell::new(
+                crate::RandomConnectionIdGenerator::new(8),
+            )),
+            crate::ConnectionId::from(&[0; 8][..]),
+        );
+        let tps = params
+            .create_transport_parameter(Role::Client, &mut cid_manager)
+            .unwrap();
+        let local = tps.local();
+        assert_eq!(local.get_integer(MaxUdpPayloadSize), 1350);
+        assert_eq!(local.get_integer(MaxAckDelay), 25);
+        assert_eq!(local.get_integer(AckDelayExponent), 3);
+        assert!(!local.has_value(MinAckDelay));
+        assert_eq!(local.get_integer(ActiveConnectionIdLimit), 2);
+    }
