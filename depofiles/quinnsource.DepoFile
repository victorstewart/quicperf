-#[cfg(feature = "__rustls-post-quantum-test")]
@@ -70 +69,2 @@ impl crypto::Session for TlsSession {
-            #[cfg(feature = "__rustls-post-quantum-test")]
+            protocol_version: self.inner.protocol_version(),
+            cipher_suite: self.inner.negotiated_cipher_suite().map(|suite| suite.suite()),
@@ -74,2 +74 @@ impl crypto::Session for TlsSession {
-                .expect("key exchange group is negotiated")
-                .name(),
+                .map(|kx| kx.name()),
@@ -267,0 +267,4 @@ pub struct HandshakeData {
+    /// The negotiated TLS protocol version.
+    pub protocol_version: Option<rustls::ProtocolVersion>,
+    /// The negotiated TLS cipher suite.
+    pub cipher_suite: Option<rustls::CipherSuite>,
@@ -269,2 +272 @@ pub struct HandshakeData {
-    #[cfg(feature = "__rustls-post-quantum-test")]
-    pub negotiated_key_exchange_group: NamedGroup,
+    pub negotiated_key_exchange_group: Option<NamedGroup>,
diff --git a/quinn-proto/src/lib.rs b/quinn-proto/src/lib.rs
index 5982b69033db7e1d366e05074fdf32098509976a..cfafc1f25efe0c4495b5456939fc7b52a72de1b9 100644
--- a/quinn-proto/src/lib.rs
+++ b/quinn-proto/src/lib.rs
@@ -48,0 +49 @@ pub use crate::connection::{
+    QuicperfNegotiatedTransport,
diff --git a/quinn-proto/src/transport_parameters.rs b/quinn-proto/src/transport_parameters.rs
index d1ddfbe9535bb2fea16bdf44bc3c96eec9ce7aa0..7a153d98b7c9e656bc1b4c2aa21cffc52ea99c1d 100644
--- a/quinn-proto/src/transport_parameters.rs
+++ b/quinn-proto/src/transport_parameters.rs
@@ -22 +21,0 @@ use crate::{
-    cid_queue::CidQueue,
@@ -148 +147 @@ impl TransportParameters {
-        cid_gen: &dyn ConnectionIdGenerator,
+        _cid_gen: &dyn ConnectionIdGenerator,
@@ -163,7 +162,3 @@ impl TransportParameters {
-            disable_active_migration: server_config.is_some_and(|c| !c.migration),
-            active_connection_id_limit: if cid_gen.cid_len() == 0 {
-                2 // i.e. default, i.e. unsent
-            } else {
-                CidQueue::LEN as u32
-            }
-            .into(),
+            disable_active_migration: config.quicperf_disable_active_migration
+                || server_config.is_some_and(|c| !c.migration),
+            active_connection_id_limit: config.quicperf_active_connection_id_limit,
@@ -174,3 +169,3 @@ impl TransportParameters {
-            min_ack_delay: Some(
-                VarInt::from_u64(u64::try_from(TIMER_GRANULARITY.as_micros()).unwrap()).unwrap(),
-            ),
+            min_ack_delay: config.ack_frequency_config.as_ref().map(|_| {
+                VarInt::from_u64(u64::try_from(TIMER_GRANULARITY.as_micros()).unwrap()).unwrap()
+            }),
QUICPERF_NEGOTIATED_SETTINGS_PATCH
if git -C "$source_dir" apply --unidiff-zero --check "$settings_patch_file"; then
  git -C "$source_dir" apply --unidiff-zero "$settings_patch_file"
elif git -C "$source_dir" apply --unidiff-zero --reverse --check "$settings_patch_file"; then
  :
else
  echo "quicperf negotiated-settings patch does not match pinned source" >&2
  exit 1
fi
flow_control_patch_file="$DEPO_BUILD_DIR/quicperf-flow-control-counters.patch"
cat > "$flow_control_patch_file" <<'QUICPERF_FLOW_CONTROL_PATCH'
diff --git a/quinn-proto/src/connection/mod.rs b/quinn-proto/src/connection/mod.rs
index b399c34e..c39e4b03 100644
--- a/quinn-proto/src/connection/mod.rs
+++ b/quinn-proto/src/connection/mod.rs
@@ -1359,6 +1359,12 @@ impl Connection {
         }
     }

+    /// Return cumulative native flow-control block decisions.
+    #[doc(hidden)]
+    pub fn quicperf_flow_control_blocked_events(&self) -> (u64, u64) {
+        self.streams.quicperf_flow_control_blocked_events()
+    }
+
     /// Whether the connection is in the process of being established
     ///
     /// If this returns `false`, the connection may be either established or closed, signaled by the
diff --git a/quinn-proto/src/connection/streams/mod.rs b/quinn-proto/src/connection/streams/mod.rs
index 6e771076..980d5de4 100644
--- a/quinn-proto/src/connection/streams/mod.rs
+++ b/quinn-proto/src/connection/streams/mod.rs
@@ -260,11 +260,25 @@ impl<'a> SendStream<'a> {
                 stream.connection_blocked = true;
                 self.state.connection_blocked.push(self.id);
             }
+            if self.state.max_data == self.state.data_sent {
+                self.state.flow_control_blocked_events =
+                    self.state.flow_control_blocked_events.saturating_add(1);
+            }
             return Err(WriteError::Blocked);
         }

         let was_pending = stream.is_pending();
-        let written = stream.write(source, limit)?;
+        let written = match stream.write(source, limit) {
+            Ok(written) => written,
+            Err(WriteError::Blocked) => {
+                self.state.stream_flow_control_blocked_events = self
+                    .state
+                    .stream_flow_control_blocked_events
+                    .saturating_add(1);
+                return Err(WriteError::Blocked);
+            }
+            Err(error) => return Err(error),
+        };
         self.state.data_sent += written.bytes as u64;
         self.state.unacked_data += written.bytes as u64;
         trace!(stream = %self.id, "wrote {} bytes", written.bytes);
diff --git a/quinn-proto/src/connection/streams/state.rs b/quinn-proto/src/connection/streams/state.rs
index ee063afd..91d02e1e 100644
--- a/quinn-proto/src/connection/streams/state.rs
+++ b/quinn-proto/src/connection/streams/state.rs
@@ -127,6 +127,10 @@ pub struct StreamsState {
     ///
     /// Note this may be less than `unacked_data` if the user has set a new value.
     pub(super) send_window: u64,
+    /// Writes rejected by the peer's connection-level flow-control limit.
+    pub(super) flow_control_blocked_events: u64,
+    /// Writes rejected by the peer's stream-level flow-control limit.
+    pub(super) stream_flow_control_blocked_events: u64,
     /// Configured upper bound for how much unacked data the peer can send us per stream
     pub(super) stream_receive_window: u64,

@@ -178,6 +182,8 @@ impl StreamsState {
             data_recvd: 0,
             unacked_data: 0,
             send_window,
+            flow_control_blocked_events: 0,
+            stream_flow_control_blocked_events: 0,
             stream_receive_window: stream_receive_window.into(),
             initial_max_stream_data_uni: 0u32.into(),
             initial_max_stream_data_bidi_local: 0u32.into(),
@@ -786,6 +792,13 @@ impl StreamsState {
             .min(self.send_window.saturating_sub(self.unacked_data))
     }

+    pub(crate) fn quicperf_flow_control_blocked_events(&self) -> (u64, u64) {
+        (
+            self.flow_control_blocked_events,
+            self.stream_flow_control_blocked_events,
+        )
+    }
+
     /// Yield stream events
     pub(crate) fn poll(&mut self) -> Option<StreamEvent> {
         if let Some(dir) = Dir::iter().find(|&i| mem::replace(&mut self.opened[i as usize], false))
QUICPERF_FLOW_CONTROL_PATCH
if git -C "$source_dir" apply --check "$flow_control_patch_file"; then
  git -C "$source_dir" apply "$flow_control_patch_file"
elif git -C "$source_dir" apply --reverse --check "$flow_control_patch_file"; then
  :
else
  echo "quicperf flow-control-counter patch does not match pinned source" >&2
  exit 1
fi
source_index="$DEPO_BUILD_DIR/quicperf-source.index"
rm -f "$source_index"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" read-tree HEAD
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$patch_file"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --unidiff-zero --cached "$settings_patch_file"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$flow_control_patch_file"
test "$(GIT_INDEX_FILE="$source_index" git -C "$source_dir" write-tree)" = "9557a169aaef0fa5a8ebc30ef1b7c8e5ddcf9e10"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" diff --quiet --no-ext-diff -- .
EOF
STAGE_TREE SOURCE . share/quinn
TARGET quinnsource::source INTERFACE share/quinn
