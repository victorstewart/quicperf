NAME mvfst
VERSION main-155afab-quicperf7
SYSTEM_LIBS ALLOW
DEPENDS boost VERSION 1.91.0-quicperf3
DEPENDS fizz VERSION main-44ca082-quicperf9
DEPENDS folly VERSION main-5e1874-quicperf9
DEPENDS fmt VERSION 12.1.0-quicperf2
DEPENDS gflags VERSION 2.3.0-quicperf2
DEPENDS glog VERSION 0.7.1-quicperf2
DEPENDS openssl VERSION 4.0.0
SOURCE GIT https://github.com/facebook/mvfst.git 155afab7b4f0d0bd4cc8adf45ac24ed55569ad78
BUILD_SYSTEM CMAKE
CMAKE_ARG "-DCMAKE_PREFIX_PATH=${dep:boost};${dep:fizz};${dep:folly};${dep:fmt};${dep:gflags};${dep:glog};${dep:openssl}"
CMAKE_ARG "-DCMAKE_INCLUDE_PATH=${dep:boost}/include;${dep:openssl}/include"
CMAKE_ARG "-DCMAKE_LIBRARY_PATH=${dep:openssl}/lib"
CMAKE_DEFINE CMAKE_POLICY_DEFAULT_CMP0167=NEW
CMAKE_DEFINE BUILD_SHARED_LIBS=OFF
CMAKE_DEFINE BUILD_TESTS=OFF
CMAKE_DEFINE BUILD_SAMPLES=OFF
CMAKE_DEFINE BUILD_TOOLS=OFF
CMAKE_BUILD_SH <<'EOF'
set -eu
source_dir="$DEPO_SOURCE_DIR"
patch_file="$DEPO_BUILD_DIR/quicperf-dependency.patch"
test "$(git -C "$source_dir" rev-parse HEAD)" = "155afab7b4f0d0bd4cc8adf45ac24ed55569ad78"
test "$(git -C "$source_dir" rev-parse 'HEAD^{tree}')" = "b91ad3bfc1eb8acdce63571f8d5662ad7b590953"
cat > "$patch_file" <<'QUICPERF_DEPENDENCY_PATCH'
diff --git a/quic/QuicConstants.h b/quic/QuicConstants.h
index 4db62267..37249e0c 100644
--- a/quic/QuicConstants.h
+++ b/quic/QuicConstants.h
@@ -17,6 +17,7 @@
 #include <chrono>
 #include <cmath>
 #include <cstdint>
+#include <limits>
 #include <memory>
 #include <optional>
 #include <ostream>
@@ -44,8 +45,42 @@ using SystemClock = folly::chrono::SystemClock;
 
 namespace quic {
 
-using Clock = std::chrono::steady_clock;
-using TimePoint = std::chrono::time_point<Clock>;
+// quicperf drives mvfst with the monotonic timestamp supplied by its common
+// C++ event loop. Inheriting steady_clock deliberately preserves mvfst's
+// public time_point ABI while replacing only the now() source.
+class Clock final : public std::chrono::steady_clock {
+ public:
+  static time_point now() noexcept {
+    if (!injectedNowSet_) std::terminate();
+    return time_point(std::chrono::duration_cast<duration>(
+        std::chrono::nanoseconds(injectedNowRawNanoseconds_)));
+  }
+
+  static bool setNowRawNanoseconds(uint64_t nowRawNanoseconds) noexcept {
+    if (nowRawNanoseconds == 0 ||
+        nowRawNanoseconds >
+            static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
+        (injectedNowSet_ && nowRawNanoseconds <
+             static_cast<uint64_t>(injectedNowRawNanoseconds_))) {
+      return false;
+    }
+    injectedNowRawNanoseconds_ = nowRawNanoseconds;
+    injectedNowSet_ = true;
+    return true;
+  }
+
+  static void resetInjectedNow() noexcept {
+    injectedNowRawNanoseconds_ = 0;
+    injectedNowSet_ = false;
+  }
+
+  static bool hasInjectedNow() noexcept { return injectedNowSet_; }
+
+ private:
+  inline static thread_local int64_t injectedNowRawNanoseconds_{0};
+  inline static thread_local bool injectedNowSet_{false};
+};
+using TimePoint = Clock::time_point;
 using DurationRep = std::chrono::microseconds::rep;
 using PathIdType = uint32_t;
 using namespace std::chrono_literals;
