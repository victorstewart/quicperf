QUICPERF_TREATMENT_PATCH
sed -i 's/^QUICPERF_CONTEXT_BLANK$/ /' "$treatment_patch"
if git -C "$source_dir" apply --check "$treatment_patch"; then
  git -C "$source_dir" apply "$treatment_patch"
elif git -C "$source_dir" apply --reverse --check "$treatment_patch"; then
  :
else
  echo "quicperf treatment patch does not match pinned source" >&2
  exit 1
fi
source_index="$DEPO_BUILD_DIR/quicperf-source.index"
rm -f "$source_index"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" read-tree HEAD
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$patch_file"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" apply --cached "$treatment_patch"
test "$(GIT_INDEX_FILE="$source_index" git -C "$source_dir" write-tree)" = "59aa0e7be281d9b9c60be717fcdd32b91fb191cf"
GIT_INDEX_FILE="$source_index" git -C "$source_dir" diff --quiet --no-ext-diff -- .
cmake --build "$DEPO_BUILD_DIR" --parallel "$(nproc)"
EOF
CMAKE_INSTALL_SH <<'EOF'
cmake --install "${DEPO_BUILD_DIR}" --prefix "${DEPO_PREFIX}"
mkdir -p "${DEPO_BUILD_DIR}/cmake-install-config"
cp -a "${DEPO_PREFIX}/lib/cmake/mvfst" "${DEPO_BUILD_DIR}/cmake-install-config/mvfst"
EOF
STAGE_TREE BUILD cmake-install-config/mvfst lib/cmake/mvfst
TARGET mvfst::cmake INTERFACE lib/cmake/mvfst
TARGET mvfst::mvfst STATIC lib/libmvfst.a INTERFACE include
LINK mvfst::mvfst fizz::fizz folly::folly fmt::fmt gflags::gflags glog::glog openssl event event_pthreads dl pthread m rt
